# .gitignore for SLDS 42.510 project 1.3
# Put this file in the project folder (next to .Renviron) BEFORE the first `git add`.

# Secrets: the LTA key, the alert URL and any other keys live here. Never commit.
.Renviron
.env

# Data: too large for Git. LTA serves only the current state, so back up data_raw/ separately.
data_raw/
data_raw_*/
data_processed/

# Figures are regenerated by code. Delete this line when you commit the final figures.
figures/

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# R
.Rhistory
.RData
.Rproj.user/
renv/library/

# Old files kept on your machine only
_superseded/

# Temporary and system files
*.partial
~$*
Thumbs.db
desktop.ini
.DS_Store

# Personal to-do list: kept locally, not shared
TODO.md
